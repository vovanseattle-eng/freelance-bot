# Telegram Bot Token (от @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Userbot (для прослушивания TG-каналов и чатов)
# Получить на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Номер телефона второго аккаунта (например +79991234567) для первой авторизации
TELEGRAM_PHONE=+79991234567

# Интервал опроса RSS-бирж в секундах (по умолчанию 60 сек)
RSS_POLL_INTERVAL=60

# Путь к базе данных SQLite
DATABASE_PATH=freelance_orders.db
